# Environnement des tests automatisés.
#
# Chargé par Laravel parce que `phpunit.xml` fixe APP_ENV=testing. Il n'existe
# que pour une raison : ne JAMAIS toucher à la base de développement. La suite
# utilise `RefreshDatabase`, qui vide et remigre — se tromper de base coûte
# toutes les données locales.
#
# Les tests tournent sur un vrai PostgreSQL et non sur SQLite en mémoire : tout
# ce que ce projet garantit est écrit en PostgreSQL (colonnes calculées, index
# partiels, contraintes CHECK, triggers, verrous de ligne). Une suite verte sur
# une autre base ne prouverait rien.
#
#   docker compose exec postgres psql -U factura -d postgres \
#       -c "CREATE DATABASE factura_test OWNER factura"

APP_ENV=testing
APP_KEY=base64:M1S/bTm5tk88tRKqul/f1vhhJc2X0IGjSxEzTYVeA2U=
APP_DEBUG=true

# Clé jetable, propre à cette base de test locale et à rien d'autre. Elle est
# versionnée pour que la suite démarre sans préparation ; la clé de production
# ne sort jamais du `.env`, lui-même ignoré par git.

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=factura_test
DB_USERNAME=factura
DB_PASSWORD=factura

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
