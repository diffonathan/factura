<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Les tests tournent sur un VRAI PostgreSQL, pas sur SQLite en
            mémoire. Ce n'est pas un choix de confort : tout ce que ce projet
            garantit est écrit en PostgreSQL — colonnes calculées, index
            partiels, contraintes CHECK, triggers, verrous de ligne. SQLite
            n'en connaît presque rien et laisserait passer les erreurs que ces
            tests existent précisément pour attraper. Une suite verte sur une
            base qui n'est pas celle de la production est pire qu'une suite
            absente : elle rassure à tort.

            `force` est nécessaire parce que le conteneur définit déjà
            DB_CONNECTION dans son environnement, et qu'une variable présente
            gagne sur la valeur déclarée ici.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="factura_test" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
