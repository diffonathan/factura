# Image de production de Factura.
#
# Différente de celle de développement, et pour de bonnes raisons :
#
#   - le code est COPIÉ dans l'image, pas monté. Une image de production doit
#     pouvoir tourner sans le dépôt ;
#   - les dépendances sont installées sans celles de développement, et
#     l'autochargement est optimisé ;
#   - le front est construit ici, dans une étape séparée, pour ne pas
#     embarquer Node dans l'image finale ;
#   - opcache ne revalide plus les horodatages : en production le code ne
#     change pas entre deux démarrages, et vérifier chaque fichier à chaque
#     requête coûte un appel système pour rien.

# ---------------------------------------------------------------------------
# Étape 1 — le front
# ---------------------------------------------------------------------------
FROM node:22-alpine AS front

WORKDIR /build

# Les manifestes d'abord : tant qu'ils ne changent pas, Docker réutilise la
# couche d'installation. Copier tout le projet d'emblée réinstallerait les
# dépendances à chaque modification d'un composant.
COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.js ./
COPY resources ./resources
RUN npm run build

# ---------------------------------------------------------------------------
# Étape 2 — les dépendances PHP
# ---------------------------------------------------------------------------
FROM composer:latest AS dependances

WORKDIR /build

COPY composer.json composer.lock ./

# `--no-scripts` : les scripts de Laravel appellent artisan, qui a besoin du
# code applicatif — absent à ce stade. Ils sont rejoués à l'étape suivante.
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-interaction \
        --prefer-dist \
        --optimize-autoloader

# ---------------------------------------------------------------------------
# Étape 3 — l'image servie
# ---------------------------------------------------------------------------
FROM php:8.4-cli-alpine

# Bibliothèques d'EXÉCUTION d'abord, en-têtes de compilation dans un groupe
# supprimé seul. L'inverse produit une image qui se construit sans erreur et
# dont pdo_pgsql refuse de se charger — Laravel répond alors « could not find
# driver », un message qui ne désigne pas la cause.
RUN apk add --no-cache libpq icu-libs libzip oniguruma \
    && apk add --no-cache --virtual .build-deps \
        postgresql-dev icu-dev libzip-dev oniguruma-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql intl zip bcmath opcache \
    && apk del .build-deps

COPY docker/php/php.production.ini /usr/local/etc/php/conf.d/factura.ini

WORKDIR /app

COPY . .
COPY --from=dependances /build/vendor ./vendor
COPY --from=front /build/public/build ./public/build

# Les scripts de composer, maintenant que le code est là.
RUN php artisan package:discover --ansi \
    && chmod -R 775 storage bootstrap/cache

COPY docker/php/demarrer.sh /usr/local/bin/demarrer
RUN chmod +x /usr/local/bin/demarrer

# Tout ce qui n'est PAS secret est posé ici.
#
# La raison est pratique : chaque variable à saisir à la main dans l'interface
# d'un hébergeur est une occasion de se tromper, et une faute de frappe sur
# `QUEUE_CONNECTION` ne se voit qu'au moment où une relance ne part pas. Il ne
# reste donc à saisir que ce qui ne peut pas vivre dans une image publique :
# la clé de chiffrement, l'adresse de la base, le mot de passe de la
# documentation, et l'adresse publique du service.
ENV APP_NAME=Factura \
    APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=pgsql \
    LOG_CHANNEL=stderr \
    # En mémoire plutôt qu'en base : sans processus séparé pour les files
    # d'attente, un dépôt de sessions en base ferait un aller-retour par
    # requête pour rien. Contrepartie assumée : un redémarrage déconnecte.
    SESSION_DRIVER=cookie \
    CACHE_STORE=file \
    # L'offre gratuite ne permet pas un second processus : les travaux en file
    # s'exécutent donc pendant la requête. Le code du travail est inchangé,
    # seul son mode d'exécution diffère.
    QUEUE_CONNECTION=sync \
    # Le serveur intégré de PHP traite UNE requête à la fois : sans ouvriers,
    # le CSS, le JS et l'icône attendent chacun leur tour.
    PHP_CLI_SERVER_WORKERS=4

# L'hébergeur impose le port par une variable et ne le connaît pas à l'avance :
# l'écrire en dur rendrait le service injoignable. 8080 est la valeur par
# défaut de Zeabur ; Render en donne une autre, et les deux fonctionnent.
ENV PORT=8080
EXPOSE 8080

CMD ["demarrer"]
